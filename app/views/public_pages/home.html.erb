<% content_for :title, "Home AI Telegram Bot" %>

<section class="mx-auto max-w-2xl space-y-6 text-slate-800">
  <h1 class="text-3xl font-semibold">Home AI Telegram Bot</h1>

  <p>
    A private household assistant that helps its authorised users manage menus,
    shopping, expenses, and calendar events through Telegram.
  </p>

  <p>
    When a household chooses to connect Google Calendar, the app uses that
    permission only to read calendar events and create or manage events requested
    by that household.
  </p>

  <p>
    <%= link_to "Privacy policy", privacy_path, class: "text-blue-700 underline" %>
  </p>
</section>
